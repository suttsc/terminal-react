# Neon pooled connection string (the Vercel Marketplace integration sets it)
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/suttsc
# openssl rand -hex 32
PAYLOAD_SECRET=
# npx auth secret. Also seals the flash cookie and signs sudo_attempts
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed for `next start` outside Vercel
AUTH_TRUST_HOST=true

# The one address allowed in
OWNER_EMAIL=
# The /hire mailto
SITE_CONTACT_EMAIL=
# For /uptime
SITE_REGISTERED_AT=2026-08-26

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Seed only: copied into the integrations global on first run, then rotated there
STRAVA_REFRESH_TOKEN=

# Bearer token Vercel sends to the cron routes
CRON_SECRET=
